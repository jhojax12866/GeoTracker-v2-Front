{
  "rewrites": [
    { "source": "/track/:trackId", "destination": "/tracker.html" },
    { "source": "/view/:trackId",  "destination": "/viewer.html"  }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "geolocation=(self)" }
      ]
    }
  ]
}
